# URL da plataforma de agendamento do barbeiro.
BOOKING_URL=https://exemplo.com/agendamento

# Credenciais, se a plataforma exigir login.
BARBER_USERNAME=
BARBER_PASSWORD=

# Seus dados para preencher o agendamento.
CUSTOMER_NAME=
CUSTOMER_PHONE=

# Preferencias do agendamento.
BRANCH_NAME=Imbariê
PROFESSIONAL_NAME=Weslley gomes
SERVICE_NAME=Corte de cabelo
PREFERRED_DATE=
PREFERRED_TIME=11:00
FALLBACK_AFTER_TIME=16:30
BOOKING_DAYS_AHEAD=7
TARGET_WEEKDAY=friday
TIMEZONE=America/Sao_Paulo

# Opcional: espera ate um horario local antes de abrir o navegador.
# Bom para rodar o Actions alguns minutos antes da agenda liberar.
WAIT_UNTIL_TIME=00:00
WAIT_GRACE_MINUTES=5
WAIT_MAX_MINUTES=15
SKIP_WAIT=false

# Por seguranca, comece sempre com DRY_RUN=true.
# Quando o fluxo estiver validado, mude para false nos GitHub Secrets/Variables.
DRY_RUN=true
HEADLESS=true

# Opcional: webhook para avisar sucesso/falha, ex. Discord/Slack/Make/Zapier.
NOTIFY_WEBHOOK_URL=

# Opcional: notificacao por email. Para Gmail, use senha de app.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
